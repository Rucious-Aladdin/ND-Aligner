{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug TTS Train First",
            "type": "debugpy",
            "request": "launch",
            "module": "tts.train.train_first",
            "console": "integratedTerminal",
            "justMyCode": true, // 라이브러리 내부(PyTorch 등)까지 디버깅하려면 false, 내 코드만 보려면 true
            "args": [
                // "--batch_size", "16",
                // "--num_workers", "0" // 디버깅 시에는 num_workers를 0으로 두는 것이 에러 추적에 훨씬 유리합니다!
            ],
            "env": {"CUDA_VISIBLE_DEVICES": "0"}
        }
    ]
}
